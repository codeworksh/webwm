{
  "name": "webwm",
  "version": "0.2.0",
  "description": "Browser-native dwm-style dynamic tiling for web widgets, with optional DOM and React adapters.",
  "homepage": "https://github.com/codeworksh/webwm#readme",
  "bugs": {
    "url": "https://github.com/codeworksh/webwm/issues"
  },
  "license": "MIT",
  "author": "Sanchit Kudari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeworksh/webwm.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./dom": "./dist/dom/index.mjs",
    "./react": "./dist/react/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:playground": "pnpm build && vp -C apps/playground build",
    "build:app": "pnpm build && vp -C apps/web build",
    "build:apps": "pnpm build:app && pnpm build:playground",
    "dev": "pnpm build && vp -C apps/playground dev",
    "dev:app": "pnpm build && vp -C apps/web dev",
    "dev:web": "pnpm dev:app",
    "dev:playground": "pnpm dev",
    "dev:lib": "vp pack --watch",
    "test": "vp test",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm build:apps && vp check && pnpm exec tsc -p apps/web/tsconfig.json --noEmit && pnpm exec tsc -p apps/playground/tsconfig.json --noEmit",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "bumpp": "^11.1.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.6.0"
}
